#!/data/data/com.termux/files/usr/bin/bash

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
DDS_DIR="$HOME/dds"

YELLOW='\033[0;33m'
GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m'

echo -e "${YELLOW}DDS Installer${NC}"
echo ""

# Ensure storage access
if [ ! -d ~/storage ]; then
  echo "Setting up storage access..."
  termux-setup-storage
  sleep 5
fi

# Update package lists
echo "Updating package lists..."
pkg update -y || { echo -e "${RED}Failed to update packages${NC}"; exit 1; }

# Install all dependencies
echo "Installing packages..."
pkg install apache2 php-fpm php-gd mariadb composer openssl-tool -y || { echo -e "${RED}Failed to install packages${NC}"; exit 1; }

# Configure Apache
echo "Configuring Apache..."
rm -f "$PREFIX/etc/apache2/httpd.conf"
cp httpd.conf "$PREFIX/etc/apache2/" || { echo -e "${RED}Failed to copy httpd.conf${NC}"; exit 1; }

rm -f "$PREFIX/etc/apache2/extra/httpd-ssl.conf"
cp httpd-ssl.conf "$PREFIX/etc/apache2/extra/" || { echo -e "${RED}Failed to copy httpd-ssl.conf${NC}"; exit 1; }

# Generate mime.types if missing
if [ ! -f "$PREFIX/etc/apache2/mime.types" ]; then
  cat > "$PREFIX/etc/apache2/mime.types" << 'MIMEEOF'
text/html                                       html htm shtml
text/css                                        css
text/javascript                                 js
application/json                                json
image/jpeg                                      jpeg jpg jpe
image/png                                       png
image/gif                                       gif
image/svg+xml                                   svg svgz
image/webp                                      webp
image/x-icon                                    ico
image/avif                                      avif
image/avif-sequence                             avifs
font/woff                                       woff
font/woff2                                      woff2
font/ttf                                        ttf
font/otf                                        otf
application/pdf                                 pdf
application/zip                                 zip
application/x-gzip                              gz tgz
application/xml                                 xml
text/plain                                      txt
text/markdown                                   md
audio/mpeg                                      mp3
audio/ogg                                       ogg
audio/wav                                       wav
video/mp4                                       mp4
video/webm                                      webm
MIMEEOF
  echo "Created mime.types: $PREFIX/etc/apache2/mime.types"
fi

# Configure PHP-FPM (ensure it matches the current user)
FPM_CONF="$PREFIX/etc/php-fpm.d/www.conf"
if [ -f "$FPM_CONF" ]; then
  sed -i "s/^user = nobody/user = $(whoami)/" "$FPM_CONF"
  sed -i "s/^group = nobody/group = $(whoami)/" "$FPM_CONF"
  sed -i "s/^;listen.owner = nobody/listen.owner = $(whoami)/" "$FPM_CONF"
  sed -i "s/^;listen.group = nobody/listen.group = $(whoami)/" "$FPM_CONF"
  sed -i "s/^;listen.mode = 0660/listen.mode = 0660/" "$FPM_CONF"
fi

# Generate SSL certificate
echo "Generating SSL certificate..."
openssl req -x509 -newkey rsa:2048 -keyout server.key -out server.crt -days 365 -nodes -subj '/CN=localhost'
mv -f server.crt "$PREFIX/etc/apache2/"
mv -f server.key "$PREFIX/etc/apache2/"

# Install dds CLI
rm -f "$PREFIX/bin/dds"
chmod +x dds
cp dds "$PREFIX/bin/"

# Set up dds-ui if Node.js available
if command -v node &>/dev/null && [ -f dds-ui/package.json ]; then
  echo "Setting up dds-ui visual interface..."
  (cd dds-ui && npm install --no-audit --no-fund)
  node --input-type=module -e "import('$DDS_DIR/dds-ui/vhost.js').then(m => m.generateVhostConfig())" 2>/dev/null || true
fi

# Set up htdocs
mkdir -p /sdcard/htdocs
cp -n .htaccess /sdcard/htdocs/

# phpinfo
php_info='/sdcard/htdocs/phpinfo'
if [ ! -d "$php_info" ]; then
  mkdir "$php_info"
  echo "<?php phpinfo(); ?>" > "$php_info/index.php"
fi

# phpMyAdmin
if [ ! -d /sdcard/htdocs/phpmyadmin ]; then
  cd /sdcard/htdocs && composer create-project phpmyadmin/phpmyadmin
fi

cp -f config.inc.php /sdcard/htdocs/phpmyadmin/config.inc.php

# Configure MariaDB for local-only access (skip networking, Unix socket only)
MARIADB_CNF_DIR="$PREFIX/etc/my.cnf.d"
mkdir -p "$MARIADB_CNF_DIR"
cat > "$MARIADB_CNF_DIR/dds-server.cnf" << 'DDS_MDB'
[mariadbd]
skip-networking
socket = /data/data/com.termux/files/usr/var/run/mysqld.sock
pid-file = /data/data/com.termux/files/usr/var/run/mariadb.pid
DDS_MDB
echo "MariaDB configured (skip-networking, Unix socket only)"

# PHP security hardening
PHP_INI="$PREFIX/etc/php/php.ini"
if [ ! -f "$PHP_INI" ]; then
  cat > "$PHP_INI" << 'PHPEOF'
[PHP]
expose_php = Off
display_errors = Off
display_startup_errors = Off
max_execution_time = 30
max_input_time = 60
memory_limit = 128M
post_max_size = 20M
upload_max_filesize = 20M
date.timezone = UTC
disable_functions = exec,passthru,shell_exec,system,proc_open,popen,show_source
allow_url_fopen = Off
allow_url_include = Off
PHPEOF
  echo "PHP hardened: $PHP_INI"
fi

echo ""
echo -e "${GREEN}DDS installed successfully.${NC}"
echo "/sdcard/htdocs - is your document directory."
echo "Place your files in /sdcard/htdocs"
echo -e "Run: ${YELLOW}dds start${NC}"
