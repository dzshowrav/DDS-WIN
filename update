#!/data/data/com.termux/files/usr/bin/bash

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"

BLUE='\033[0;34m'
RED='\033[0;31m'
YELLOW='\033[0;33m'
NC='\033[0m'

echo "${BLUE}Updating DDS..${NC}"

# Stop services if they exist
if command -v apachectl &>/dev/null; then
  apachectl stop >/dev/null 2>&1 || true
fi
pgrep mariadb && pkill mariadb 2>/dev/null || true
pgrep php-fpm && pkill php-fpm 2>/dev/null || true

# Update configs
rm -f "$PREFIX/etc/apache2/httpd.conf"
cp httpd.conf "$PREFIX/etc/apache2/"
rm -f "$PREFIX/etc/apache2/extra/httpd-ssl.conf"
cp httpd-ssl.conf "$PREFIX/etc/apache2/extra/"

# Generate mime.types if missing
if [ ! -f "$PREFIX/etc/apache2/mime.types" ]; then
  cat > "$PREFIX/etc/apache2/mime.types" << 'MIMEEOF'
text/html                                       html htm shtml
text/css                                        css
text/javascript                                 js
application/json                                json
image/jpeg                                      jpeg jpg jpe
image/png                                       png
image/gif                                       gif
image/svg+xml                                   svg svgz
image/webp                                      webp
image/x-icon                                    ico
image/avif                                      avif
image/avif-sequence                             avifs
font/woff                                       woff
font/woff2                                      woff2
font/ttf                                        ttf
font/otf                                        otf
application/pdf                                 pdf
application/zip                                 zip
application/x-gzip                              gz tgz
application/xml                                 xml
text/plain                                      txt
text/markdown                                   md
audio/mpeg                                      mp3
audio/ogg                                       ogg
audio/wav                                       wav
video/mp4                                       mp4
video/webm                                      webm
MIMEEOF
  echo "Created mime.types: $PREFIX/etc/apache2/mime.types"
fi

rm -f "$PREFIX/bin/dds"
chmod +x dds
cp dds "$PREFIX/bin/"

if command -v node &>/dev/null && [ -f dds-ui/package.json ] && [ ! -d dds-ui/node_modules ]; then
  echo "Setting up dds-ui visual interface..."
  (cd dds-ui && npm install --no-audit --no-fund)
fi

cp -n .htaccess /sdcard/htdocs/
cp -f config.inc.php /sdcard/htdocs/phpmyadmin/config.inc.php

# Ensure MariaDB skip-networking config exists
MARIADB_CNF_DIR="$PREFIX/etc/my.cnf.d"
if [ ! -f "$MARIADB_CNF_DIR/dds-server.cnf" ]; then
  mkdir -p "$MARIADB_CNF_DIR"
  cat > "$MARIADB_CNF_DIR/dds-server.cnf" << 'DDS_MDB'
[mariadbd]
skip-networking
socket = /data/data/com.termux/files/usr/var/run/mysqld.sock
pid-file = /data/data/com.termux/files/usr/var/run/mariadb.pid
DDS_MDB
  echo "MariaDB configured (skip-networking, Unix socket only)"
fi

echo "${RED}Done!${NC}"
echo "${YELLOW}DDS is up to date.${NC}"
echo ""

# Regenerate vhost config
if command -v node &>/dev/null && [ -f dds-ui/vhost.js ] && [ -f dds-ui/hosts.js ]; then
  node --input-type=module -e "import('$HOME/dds/dds-ui/vhost.js').then(m => m.generateVhostConfig())" 2>/dev/null && echo "  Vhost config regenerated" || echo "  Vhost config regeneration skipped"
fi

# Restart services after update
echo "${BLUE}Starting services..${NC}"
if command -v php-fpm &>/dev/null; then
  echo "  Starting PHP-FPM.."
  php-fpm --nodaemonize --allow-to-run-as-root &>/dev/null &
  sleep 2
  pgrep php-fpm >/dev/null 2>&1 && echo "  PHP-FPM started" || echo "  WARNING: PHP-FPM may not have started"
fi
if command -v apachectl &>/dev/null; then
  apachectl start >/dev/null 2>&1 && echo "  Apache started" || echo "  Apache failed to start (run 'dds start' manually)"
fi
if command -v mariadbd-safe &>/dev/null; then
  mariadbd-safe --pid-file="/data/data/com.termux/files/usr/var/run/mariadb.pid" &
  sleep 2
  echo "  MariaDB started"
fi
